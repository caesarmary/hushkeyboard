<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 6.0–11 (API 23–30).
    android:allowBackup="false" in the manifest already disables Auto Backup on
    these versions. These exclude rules make the intent explicit and guard against
    any future change to allowBackup.
-->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
