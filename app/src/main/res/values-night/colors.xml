<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme keyboard palette. Near-black board, raised charcoal keys,
         a brighter teal accent so it carries on dark surfaces. -->
    <color name="keyboard_bg">#16181C</color>
    <color name="key_letter">#34373D</color>
    <color name="key_letter_pressed">#474B52</color>
    <color name="key_action">#24262B</color>
    <color name="key_action_pressed">#34373D</color>
    <color name="key_shift_off">#24262B</color>
    <color name="key_shift_off_pressed">#34373D</color>
    <color name="key_shift_oneshot">#0E7C86</color>
    <color name="key_shift_oneshot_pressed">#11929E</color>
    <color name="key_shift_capslock">#11929E</color>
    <color name="key_shift_capslock_pressed">#15ABB9</color>
    <color name="key_text">#F2F3F5</color>
    <color name="key_preview_bg">#0E7C86</color>
    <color name="key_alternates_chip">#1E3A3D</color>
    <color name="key_alternates_chip_active">#2C5A5F</color>

    <!-- Accent is brighter in dark so it stays legible on dark surfaces. -->
    <color name="accent">#2BB5C0</color>
    <color name="accent_pressed">#15ABB9</color>

    <!-- In dark mode action keys are DARKER than letter keys, so their glyphs
         stay light (same as key_text). -->
    <color name="key_text_action">#F2F3F5</color>

    <color name="suggestion_divider">#2A2D33</color>

    <color name="settings_bg">#0F1113</color>
    <color name="settings_card">#1A1C20</color>
    <color name="settings_text_primary">#F2F3F5</color>
    <color name="settings_text_secondary">#A0A6AE</color>
    <color name="divider">#34373D</color>
    <color name="destructive">#F2B8B5</color>
</resources>
